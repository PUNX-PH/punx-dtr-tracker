rules_version = '2';

// punx-dtr security rules.
//
// These replace `allow read, write: if request.auth != null` on `/{document=**}`,
// which let ANY authenticated Google account read and write the entire database.
// The `@punx.ai` check in Login.jsx runs in JavaScript AFTER Firebase Auth has
// already issued a token, so it gates the UI and not the data — anyone talking
// to Firestore directly never reaches it. The web config needed to do that is
// public by design, committed in src/firebase.js and shipped in the bundle.
//
// Written against an audit of every call in src/services/api.js. The notes on
// individual rules say which screen depends on them, because the failure mode
// here is not a vulnerability, it is payroll going down.
//
// HOW A LIST QUERY IS EVALUATED — this shapes everything below.
// A query is NOT checked against the documents it returns. The rule is
// evaluated ONCE against the *query*, with a `resource` that knows only what
// the query's own filters prove. `where('employeeId','==',uid)` makes
// `resource.data.employeeId` readable; an unfiltered query leaves it unknown,
// and reading an unknown field is an ERROR, which denies.
//
// So `resource.data.employeeId == myUid()` is not merely a permission check —
// it is what refuses an unfiltered listing of the whole collection. Do not
// "defensively" guard those reads with `in`; a guarded read evaluates to false
// instead of erroring, the rule passes, and the collection is handed over.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    // The caller's own profile. Guarded with exists() because a first-time
    // Google sign-in reads and writes before any profile exists, and get() on a
    // missing document errors — which would deny the very create that fixes it.
    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    // Offboarded by a super admin (AdminDashboard "Remove"). The profile is
    // kept — their logs are payroll history — but the person has left, so
    // they get none of the access below. Someone with no profile yet (first
    // sign-in, mid-create) is not removed.
    function isRemoved() {
      return hasProfile() && myProfile().get('removed', false) == true;
    }

    // Signed in AND still with the company. Every owner leg uses this rather
    // than signedIn(), so a departed employee cannot keep editing their own
    // DTR by talking to Firestore directly.
    function active() {
      return signedIn() && !isRemoved();
    }

    // Defaults matter: documents predating a field must not error the rule.
    function myRole() {
      return hasProfile() && !isRemoved() ? myProfile().get('role', 'employee') : 'none';
    }

    function isAdmin() {
      return myRole() in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return myRole() == 'super_admin';
    }

    // Senior is a FLAG, not a role — App.jsx routes on `isSenior === true`
    // independently of role. Seniors review their assigned employees' DTRs, so
    // they read the same collections admins do.
    function isSenior() {
      return hasProfile() && !isRemoved() && myProfile().get('isSenior', false) == true;
    }

    function isStaff() {
      return isAdmin() || isSenior();
    }

    // ---- users ----
    // Holds `pin`, which is a credential: the app's legacy login() authenticates
    // with `where('pin','==',pin)` alone. Under the old rules any signed-in
    // account could list every user and harvest them. That login path is dead
    // code today, but the field is still in the documents.
    match /users/{userId} {
      // Own profile always — ordered first so it short-circuits before
      // isStaff(), which cannot resolve for someone who has no profile yet.
      // Deliberately signedIn() and not active(): a removed person must still
      // read their own `removed` flag, or App.jsx cannot tell them why.
      allow get: if signedIn() && (userId == myUid() || isStaff());

      // AdminDashboard, SeniorDashboard and CutoffsView list every user.
      // Employees never do — an unfiltered list must stay denied for them.
      //
      // The owner leg is for ONE query: api.ensureUserProfile's legacy lookup,
      // `where('uid','==',myUid)`, which runs on every first sign-in BEFORE the
      // profile exists (so isStaff() cannot pass). It is provable only because
      // the filter pins `resource.data.uid`; an unfiltered or other-uid query
      // errors/fails and is denied. Do not guard this read with `.get()`.
      allow list: if isStaff()
        || (signedIn() && resource.data.uid == myUid());

      // First Google sign-in self-creates (api.ensureUserProfile). Pinned to
      // `employee`: without this, a new account creates itself as super_admin
      // and the role checks above become decoration.
      allow create: if signedIn()
        && userId == myUid()
        && request.resource.data.uid == myUid()
        && request.resource.data.get('role', 'employee') == 'employee'
        && request.resource.data.get('isSenior', false) == false;

      // role / isSenior / assignedSeniorId are admin actions. Nothing
      // self-updates a profile, so allowing it would widen the surface for no
      // caller. Removing (or restoring) someone is super_admin only, and never
      // yourself — that would be a one-click lockout of the last super admin.
      allow update: if isAdmin()
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['removed', 'removedAt', 'removedBy'])
            || (isSuperAdmin() && userId != myUid()));
      allow delete: if false;
    }

    // ---- logs ----
    // The attendance record payroll is computed from.
    match /logs/{logId} {
      // getHistory always filters by employeeId, which is what makes the owner
      // leg provable. An unfiltered list errors on that read and is denied.
      allow read: if isStaff()
        || (active() && resource.data.employeeId == myUid());

      // Admins create logs for others when correcting a DTR (api.createLog).
      allow create: if isStaff()
        || (active() && request.resource.data.employeeId == myUid());

      // Employees edit their own before submitting (DTRTable / saveDTRBatch).
      allow update, delete: if isStaff()
        || (active() && resource.data.employeeId == myUid());
    }

    // ---- cutoffs ----
    // Readable by EVERYONE signed in: Dashboard.jsx calls getActiveCutoff for
    // ordinary employees, so restricting this to staff blanks the employee
    // view. getActiveCutoff is an unfiltered orderBy query, which is fine only
    // because this rule reads no fields.
    match /cutoffs/{cutoffId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- submissions ----
    // Doc id is `{userId}_{cutoffId}`.
    match /submissions/{submissionId} {
      // The id is the only thing that says whose a MISSING doc would be.
      // Firebase Auth UIDs are alphanumeric, so the prefix is regex-safe.
      function isMyId() {
        return submissionId.matches(myUid() + '_.+');
      }

      function pending(data) {
        return data.get('status', 'pending') in ['pending', 'pending_senior'];
      }

      // Split from list on purpose. Both Dashboard.getSubmission and
      // api.submitDTR get their own doc BEFORE it exists (first submit of a
      // cutoff), and resource.data on a missing doc is an error, which denies:
      // that was "Missing or insufficient permissions" on Send to Admin.
      // A missing doc is judged by its id instead.
      allow get: if isStaff()
        || (active() && (resource == null ? isMyId() : resource.data.userId == myUid()));

      // Kept as a bare field read so an unfiltered listing still errors.
      allow list: if isStaff()
        || (active() && resource.data.userId == myUid());

      // An employee may submit and resubmit, but only into a pending state.
      // Without that clause the owner leg lets them approve their own DTR,
      // which is the entire point of having a senior review it. Create needs
      // it too: a first submission is a create, not an update.
      allow create: if isStaff()
        || (active()
            && isMyId()
            && request.resource.data.userId == myUid()
            && pending(request.resource.data));

      allow update: if isStaff()
        || (active()
            && resource.data.userId == myUid()
            && pending(request.resource.data));

      // "Resubmit / Update" on the Dashboard cancels a pending submission so
      // it can be redone. Never an approved one.
      allow delete: if isStaff()
        || (active() && resource.data.userId == myUid() && pending(resource.data));
    }

    // ---- notifications ----
    match /notifications/{notificationId} {
      // Filtered by recipientId at every call site, which is what makes this
      // provable — and what refuses an unfiltered sweep of everyone's alerts.
      allow read: if isAdmin()
        || (active() && resource.data.recipientId == myUid());

      // Anyone signed in may notify: submitting a DTR creates one addressed to
      // the reviewing senior, so the sender is not the recipient.
      allow create: if active();

      // Marking read.
      allow update: if isAdmin()
        || (active() && resource.data.recipientId == myUid());

      allow delete: if isAdmin();
    }

    // ---- leaveRequests ----
    // Sick / vacation leave and offset hours (src/services/api.js leaveApi).
    // The approval workflow lives HERE, not in the UI: whoever can flip `status`
    // is whoever these rules say can.
    match /leaveRequests/{requestId} {
      // Who may DECIDE this request: an admin, or the senior currently assigned
      // to the requester — read off the requester's profile at decision time, so
      // reassigning someone moves the approval with them. Never your own request,
      // which is what stops an admin or senior approving themselves.
      function seniorOf(uid) {
        return get(/databases/$(database)/documents/users/$(uid)).data.get('assignedSeniorId', '');
      }

      function canReview() {
        return resource.data.userId != myUid()
          && (isAdmin()
              || (isSenior() && seniorOf(resource.data.userId) == myUid()));
      }

      // The employee screen filters by userId, which is what makes the owner leg
      // provable and refuses an unfiltered sweep. Staff read the queue.
      allow read: if isStaff()
        || (active() && resource.data.userId == myUid());

      // A request starts life pending and is the requester's own. Fixed key set
      // so nothing can be smuggled in (reviewerId, a pre-set reviewedAt...).
      allow create: if active()
        && request.resource.data.userId == myUid()
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['sick', 'vacation', 'offset']
        && request.resource.data.keys().hasOnly(
             ['userId', 'userName', 'type', 'startDate', 'endDate', 'days', 'hours', 'reason', 'status', 'createdAt'])
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.days is number
        && request.resource.data.hours is number
        && request.resource.data.days >= 0 && request.resource.data.days <= 366
        && request.resource.data.hours >= 0 && request.resource.data.hours <= 8;

      // A decision touches only the review fields, and only to approved or
      // rejected. A senior decides pending requests; an admin can also revoke an
      // approved one (HR correcting a mistake). The requester cannot update at
      // all — to change a request they withdraw it and file again.
      allow update: if active() && canReview()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewerId', 'reviewerName', 'reviewedAt', 'reviewNote'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewerId == myUid()
        && (isAdmin() || resource.data.status == 'pending');

      // Withdrawing is for requests nobody has decided yet; an approved leave
      // is a record, and only an admin may remove it.
      allow delete: if (active() && resource.data.userId == myUid() && resource.data.status == 'pending')
        || isAdmin();
    }

    // ---- leaveBalances ----
    // What HR has granted, per person. Admin-written only — employees see their
    // own, and nothing here can be self-served into a bigger balance.
    match /leaveBalances/{userId} {
      // get is split from list so a person with no balance doc yet (the default
      // case) can still read "nothing here" for themselves.
      allow get: if isStaff() || (active() && userId == myUid());
      allow list: if isStaff();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---- leaveAdjustments ----
    // Append-only audit trail of balance changes. Nobody edits history.
    match /leaveAdjustments/{adjustmentId} {
      allow read: if isAdmin()
        || (active() && resource.data.userId == myUid());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---- settings ----
    // The DTR reminder's kill switch. Written only by the Cloudflare Worker via
    // a service account, which bypasses rules entirely — so the client needs no
    // write here, and is given none.
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not named above is denied. The previous catch-all is what this
    // whole file exists to remove; a new collection should have to be thought
    // about rather than inheriting access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
